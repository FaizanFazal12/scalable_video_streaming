# Ports
PORT=3000

# MongoDB (Mongoose). Standalone is fine — no replica set needed.
DATABASE_URL=mongodb://mongo:27017/video

# Redis (BullMQ queue + Pub/Sub for live progress)
REDIS_URL=redis://redis:6379

# Number of transcode jobs a single worker runs at once (CPU-bound — keep small)
WORKER_CONCURRENCY=1
