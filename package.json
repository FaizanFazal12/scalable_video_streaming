{
  "name": "video-processing-server",
  "version": "1.0.0",
  "description": "Node.js + TypeScript video processing server: upload -> transcode to HLS -> live progress via SSE. Express + MongoDB (Mongoose) + BullMQ/Redis, FFmpeg in Docker.",
  "main": "src/server.ts",
  "scripts": {
    "api": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "api:dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/worker.ts"
  },
  "license": "MIT",
  "dependencies": {
    "bullmq": "^5.21.0",
    "dotenv": "^8.2.0",
    "express": "^4.21.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.4.1",
    "mongoose": "^8.7.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
